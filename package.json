{
  "name": "aegisvolt",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma cloud-native para gestión segura de carga de flotas eléctricas.",
  "packageManager": "npm@11.17.0",
  "workspaces": ["apps/*", "services/*", "packages/*"],
  "scripts": {
    "setup": "test -f package-lock.json && npm ci --no-audit --no-fund && cp -n .env.example .env || true",
    "dev": "docker compose up --build",
    "seed": "node scripts/seed.mjs",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:resilience": "vitest run tests/resilience",
    "test:all": "npm run lint && npm run build && npm run test && npm run test:integration && npm run test:resilience",
    "test:graphql-schema": "tsx scripts/check-graphql-schema.ts",
    "validate:kubernetes": "python3 scripts/validate_kubernetes.py",
    "terraform:validate": "bash scripts/terraform-validate.sh",
    "terraform:plan:dev": "bash scripts/terraform-plan.sh dev",
    "terraform:plan:test": "bash scripts/terraform-plan.sh test",
    "terraform:plan:prod": "bash scripts/terraform-plan.sh prod",
    "kind:up": "bash scripts/kind-up.sh",
    "kind:down": "bash scripts/kind-down.sh",
    "demo:success": "node scripts/demo.mjs success",
    "demo:fail-billing": "node scripts/demo.mjs fail-billing",
    "demo:fail-charger": "node scripts/demo.mjs fail-charger",
    "demo:canary": "bash scripts/demo-canary.sh",
    "demo:canary:kind": "bash scripts/demo-canary-kind.sh",
    "prefect:run": "python3 observability/prefect/flows.py --environment ${AEGISVOLT_ENV:-dev}",
    "github:prepare": "bash scripts/github-rulesets.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@playwright/test": "1.51.1",
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@typescript-eslint/eslint-plugin": "8.24.0",
    "@typescript-eslint/parser": "8.24.0",
    "eslint": "9.20.0",
    "globals": "15.14.0",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "vite": "6.1.0",
    "vitest": "3.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.758.0",
    "@aws-sdk/lib-dynamodb": "3.758.0",
    "@fastify/cors": "11.0.0",
    "fastify": "5.2.1",
    "graphql": "16.10.0",
    "graphql-yoga": "5.10.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.2"
  }
}
